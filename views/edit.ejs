<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chat</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        button {
            margin-left: 37%;
        }
    </style>
</head>
<body>
    <h3>Edit your Chat</h3>
    <p>This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b> </p>
    <form method="post" action="/chats/<%= chat.id %>?_method=PUT">
        <textarea name="msg" rows="6" cols="50"><%= chat.msg %> </textarea>
        <br><br>
        <button>Edit Chat</button>
    </form>
</body>
</html>
